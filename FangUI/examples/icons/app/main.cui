/* Kubai Icons · 96 枚
/* 资产由 Kubai Icons 引擎导出（rest / hover 两态）；动画是 CUI 的 icon + motion，页面里不写过渡规则。

window icons
    theme light

    main wall
        layout column
        gap 22
        padding 30 34 40
        width fill
        background canvas

        heading
            text "Kubai Icons"
            page

        text
            text "96 枚 · 31×29 画布 · 460ms 缓动。icon 挂 rest / hover 两张图，motion hover 时悬停交叉到动作终态；换 always 常驻呼吸，换 still 完全静止。"
            caption
            color soft

        grid g
            columns repeat(12, 1fr)
            gap 14
            width fill

            box fr
                width 74
                height 74
                radius l
                border 1 hairline
                background gradient(180deg, card, surface)
                layout row
                justify center
                align center

                icon
